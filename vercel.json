{
  "version": 2,
  "builds": [
    {
      "src": "src/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/api/index.ts"
    }
  ],
  "functions": {
    "src/api/index.ts": {
      "includeFiles": [
        "node_modules/mysql2/**"
      ]
    }
  }
}